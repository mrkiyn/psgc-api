meta {
  name: Get province by code
  type: http
  seq: 2
}

get {
  url: {{apiUrl}}/provinces?psgc_code=0102800000
  body: none
  auth: none
}

params:query {
  psgc_code: 0102800000
}

tests {
  test("returns only the province with this code", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.pagination.total).to.equal(1);
    expect(body.data[0].psgc_code).to.equal("0102800000");
  });
}
