meta {
  name: List provinces
  type: http
  seq: 1
}

get {
  url: {{apiUrl}}/provinces?page=1&per_page=20
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 20
  ~psgc_code: 0102800000
  ~region_code: 0100000000
}

docs {
  Lists all 82 provinces, sorted by PSGC code.
  
  Query parameters:
  - `psgc_code`: return only the province with this 10-digit code
  - `region_code`: return only provinces in this region
  - `page`, `per_page`: pagination (max 100 per page)
}

tests {
  test("returns the first page of 82 provinces", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.data).to.have.lengthOf(20);
    expect(body.pagination).to.eql({ page: 1, per_page: 20, total: 82, total_pages: 5 });
  });
}
