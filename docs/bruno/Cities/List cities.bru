meta {
  name: List cities
  type: http
  seq: 1
}

get {
  url: {{apiUrl}}/cities?page=1&per_page=20
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 20
  ~psgc_code: 1380600000
  ~city_class: HUC
  ~region_code: 1300000000
  ~province_code: 0203100000
}

docs {
  Lists all 149 cities, sorted by PSGC code.
  
  Query parameters:
  - `psgc_code`: return only the city with this 10-digit code
  - `city_class`: `HUC` (highly urbanized), `ICC` (independent component) or `CC` (component)
  - `region_code`: return only cities in this region
  - `province_code`: return only cities in this province (highly urbanized cities have no province)
  - `page`, `per_page`: pagination (max 100 per page)
}

tests {
  test("returns the first page of 149 cities", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.data).to.have.lengthOf(20);
    expect(body.pagination).to.eql({ page: 1, per_page: 20, total: 149, total_pages: 8 });
  });
}
