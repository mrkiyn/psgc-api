meta {
  name: Cities by province code
  type: http
  seq: 4
}

get {
  url: {{apiUrl}}/cities?province_code=0203100000
  body: none
  auth: none
}

params:query {
  province_code: 0203100000
}

tests {
  test("every city belongs to province_code 0203100000", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.pagination.total).to.be.above(0);
    expect(body.data.every((item) => item.province_code === "0203100000")).to.equal(true);
  });
}
