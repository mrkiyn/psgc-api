meta {
  name: Get city by code
  type: http
  seq: 2
}

get {
  url: {{apiUrl}}/cities?psgc_code=1380600000
  body: none
  auth: none
}

params:query {
  psgc_code: 1380600000
}

tests {
  test("returns only the city with this code", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.pagination.total).to.equal(1);
    expect(body.data[0].psgc_code).to.equal("1380600000");
  });
}
