meta {
  name: Municipalities by city code
  type: http
  seq: 5
}

get {
  url: {{apiUrl}}/municipalities?city_code=1380600000
  body: none
  auth: none
}

params:query {
  city_code: 1380600000
}

tests {
  test("every municipality belongs to city_code 1380600000", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.pagination.total).to.be.above(0);
    expect(body.data.every((item) => item.city_code === "1380600000")).to.equal(true);
  });
}
